{
  "name": "@shamah/opencode-agentrouter",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shamahdev/opencode-agentrouter.git"
  },
  "description": "AgentRouter provider plugin for OpenCode with model discovery, pricing, pacing and gateway recovery.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "opencode-agentrouter": "dist/cli.js"
  },
  "files": [
    "dist",
    "index.ts",
    "cli.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "server.js",
    "docs"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "smoke": "npm run build && node test/opencode-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agentrouter",
    "openai",
    "anthropic"
  ],
  "devDependencies": {
    "@opencode/plugin": "2.1.4",
    "@opencode/schema": "2.1.4",
    "@types/node": "^22.0.0",
    "effect": "^4.0.1",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.1.4",
    "@opencode/schema": "2.1.4",
    "effect": "^4.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.135",
    "@ai-sdk/openai": "^3.0.134",
    "@ai-sdk/openai-compatible": "^2.0.87"
  }
}
